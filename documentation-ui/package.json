{
  "name": "@quantinuum/documentation-ui",
  "version": "1.0.0",
  "description": "Quantinuum design tokens and React components for product documentation.",
  "private": false,
  "author": {
    "name": "Irfan Khan",
    "email": "irfan.khan@quantinuum.com"
  },
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc && eslint src",
    "lint:fix": "tsc && eslint src --fix",
    "format": "biome format --write src stories",
    "format:check": "biome format src stories",
    "typecheck": "tsc --noEmit",
    "build": "rollup -c",
    "test": "vitest --silent='passed-only' .",
    "clean": "rm -rf ./dist",
    "clean-ps1": "del dist"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./docs-theme.css": "./dist/docs-theme.css",
    "./docs-kit": {
      "types": "./dist/types/src/custom/docs/kit/index.d.ts",
      "default": "./dist/src/custom/docs/kit/index.js"
    },
    "./docs-config": {
      "types": "./dist/types/src/custom/docs/kit/config.d.ts",
      "default": "./dist/src/custom/docs/kit/config.js"
    },
    "./docs-source": {
      "types": "./dist/types/src/custom/docs/kit/page-tree.d.ts",
      "default": "./dist/src/custom/docs/kit/page-tree.js"
    },
    "./tailwindTheme": {
      "types": "./dist/types/src/tailwindTheme.d.ts",
      "default": "./dist/src/tailwindTheme.js"
    }
  },
  "types": "./dist/types/src/index.d.ts",
  "mode": "production",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantinuum-dev/documentation-ui.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/quantinuum-dev/documentation-ui/issues"
  },
  "homepage": "https://github.com/quantinuum-dev/documentation-ui#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@chromatic-com/storybook": "^5.6.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-links": "^10.6.4",
    "@storybook/addon-onboarding": "^10.6.4",
    "@storybook/react": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "10.4.4",
    "fumadocs-core": "^16.17.8",
    "fumadocs-ui": "^16.17.8",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "next": "^16.4.3",
    "postcss": "^8.5.31",
    "postcss-fail-on-warn": "^0.2.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "rollup": "^4.65.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@quantinuum/quantinuum-ui": "5.4.2-tailwind-v4-sb.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "remeda": "^2.54.1",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "fumadocs-core": "^16.8.0",
    "fumadocs-ui": "^16.8.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.50.1",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependenciesMeta": {
    "fumadocs-core": {
      "optional": true
    },
    "fumadocs-ui": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    }
  }
}
