{
  "name": "@quantinuum/documentation-ui",
  "version": "1.0.0",
  "description": "Quantinuum design tokens and React components for product documentation.",
  "private": false,
  "author": {
    "name": "Irfan Khan",
    "email": "irfan.khan@quantinuum.com"
  },
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc && eslint src",
    "lint:fix": "tsc && eslint src --fix",
    "format": "biome format --write src stories",
    "format:check": "biome format src stories",
    "typecheck": "tsc --noEmit",
    "build": "rollup -c",
    "test": "vitest --silent='passed-only' .",
    "clean": "rm -rf ./dist",
    "clean-ps1": "del dist"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwindTheme": {
      "types": "./dist/types/src/tailwindTheme.d.ts",
      "default": "./dist/src/tailwindTheme.js"
    }
  },
  "packageManager": "pnpm@11.0.8",
  "types": "./dist/types/src/index.d.ts",
  "mode": "production",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantinuum-dev/documentation-ui.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/quantinuum-dev/documentation-ui/issues"
  },
  "homepage": "https://github.com/quantinuum-dev/documentation-ui#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.25.1",
    "@radix-ui/react-icons": "^1.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-links": "^10.4.4",
    "@storybook/addon-onboarding": "^10.4.4",
    "@storybook/react": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.29",
    "@types/node": "^22.19.21",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "10.4.4",
    "globals": "^15.15.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.32",
    "postcss-fail-on-warn": "^0.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "rollup": "^4.60.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "semantic-release": "^25.0.3",
    "storybook": "^10.4.4",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.0.14",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@quantinuum/quantinuum-ui": "^4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "remeda": "^2.33.7",
    "tailwind-merge": "^2.6.0",
    "tslib": "^2.8.1",
    "vaul": "^0.8.0",
    "zod": "^3.25.56"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7"
  },
  "volta": {
    "node": "22.22.3",
    "pnpm": "11.7.0"
  }
}
